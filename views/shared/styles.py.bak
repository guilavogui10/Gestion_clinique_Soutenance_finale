"""
=============================================================================
 STYLES GLOBAUX - Composants réutilisables
=============================================================================
 Fonctions QSS dynamiques qui lisent le thème actif via ThemeManager.
 Chaque fonction retourne un string QSS prêt à être injecté.

 Utilisation dans une vue :
   from views.shared.styles import Styles
   self.table.setStyleSheet(Styles.table())
   self.btn.setStyleSheet(Styles.button_primary())
=============================================================================
"""

from views.shared.theme_manager import theme_manager


class Styles:
    """
    Bibliothèque de styles QSS dynamiques.
    Toutes les méthodes sont statiques et retournent le QSS
    adapté au thème courant.
    """

    # ─────────────────────────────────────────────────────────────────────
    # BOUTONS
    # ─────────────────────────────────────────────────────────────────────

    @staticmethod
    def button_primary() -> str:
        """Bouton principal (ajout, validation, action primaire)."""
        c = theme_manager.colors()
        return f"""
            QPushButton {{
                background-color: {c['primary']};
                color: {c['text_inverse']};
                border: none;
                border-radius: 8px;
                padding: 8px 18px;
                font-weight: bold;
                font-size: 13px;
            }}
            QPushButton:hover {{
                background-color: {c['primary_hover']};
            }}
            QPushButton:pressed {{
                background-color: {c['primary']};
                padding-top: 10px;
            }}
        """

    @staticmethod
    def button_secondary() -> str:
        """Bouton secondaire (annuler, retour, filtre)."""
        c = theme_manager.colors()
        return f"""
            QPushButton {{
                background-color: {c['bg_card']};
                color: {c['text_primary']};
                border: 1px solid {c['border']};
                border-radius: 8px;
                padding: 8px 18px;
                font-size: 13px;
            }}
            QPushButton:hover {{
                background-color: {c['hover']};
                border-color: {c['primary']};
            }}
        """

    @staticmethod
    def button_danger() -> str:
        """Bouton de suppression / action destructive."""
        c = theme_manager.colors()
        return f"""
            QPushButton {{
                background-color: {c['danger']};
                color: {c['text_inverse']};
                border: none;
                border-radius: 8px;
                padding: 8px 18px;
                font-weight: bold;
                font-size: 13px;
            }}
            QPushButton:hover {{
                opacity: 0.85;
            }}
        """

    @staticmethod
    def button_icon(size: int = 36) -> str:
        """Petit bouton d'icône (éditer, supprimer dans un tableau)."""
        c = theme_manager.colors()
        return f"""
            QPushButton {{
                background-color: transparent;
                border: 1px solid {c['border']};
                border-radius: {size // 2}px;
                min-width: {size}px;
                max-width: {size}px;
                min-height: {size}px;
                max-height: {size}px;
            }}
            QPushButton:hover {{
                background-color: {c['hover']};
            }}
        """

    # ─────────────────────────────────────────────────────────────────────
    # CHAMPS DE SAISIE
    # ─────────────────────────────────────────────────────────────────────

    @staticmethod
    def input_field() -> str:
        """Champ de saisie standard (QLineEdit, QDateEdit, QComboBox)."""
        c = theme_manager.colors()
        return f"""
            QLineEdit, QDateEdit, QComboBox {{
                background-color: {c['bg_input']};
                color: {c['text_primary']};
                border: 1px solid {c['border']};
                border-radius: 10px;
                padding: 8px 14px;
                font-size: 13px;
            }}
            QLineEdit:focus, QDateEdit:focus, QComboBox:focus {{
                border: 2px solid {c['border_focus']};
            }}
            QComboBox::drop-down {{
                border: none;
                padding-right: 10px;
            }}
        """

    @staticmethod
    def search_bar() -> str:
        """Barre de recherche avec icône."""
        c = theme_manager.colors()
        return f"""
            QLineEdit {{
                background-color: {c['bg_input']};
                color: {c['text_primary']};
                border: 1px solid {c['border']};
                border-radius: 12px;
                padding: 10px 16px 10px 40px;
                font-size: 14px;
            }}
            QLineEdit:focus {{
                border: 2px solid {c['border_focus']};
            }}
        """

    # ─────────────────────────────────────────────────────────────────────
    # TABLEAUX
    # ─────────────────────────────────────────────────────────────────────

    @staticmethod
    def table() -> str:
        """Tableau de données principal."""
        c = theme_manager.colors()
        return f"""
            QTableWidget {{
                background-color: {c['bg_table']};
                alternate-background-color: {c['bg_table_alt']};
                color: {c['text_primary']};
                border: none;
                border-radius: 10px;
                gridline-color: {c['table_gridline']};
                selection-background-color: {c['table_selection']};
                font-size: 13px;
            }}
            QTableWidget::item {{
                padding: 4px;
            }}
            QTableWidget::item:selected {{
                background-color: {c['table_selection']};
                color: {c['text_primary']};
            }}
            QHeaderView::section {{
                background-color: {c['table_header_bg']};
                color: {c['text_primary']};
                padding: 10px;
                border: none;
                border-bottom: 2px solid {c['table_header_border']};
                font-weight: bold;
                font-size: 13px;
            }}
            QHeaderView {{
                background-color: {c['bg_table']};
            }}
        """

    # ─────────────────────────────────────────────────────────────────────
    # CARTES & FRAMES
    # ─────────────────────────────────────────────────────────────────────

    @staticmethod
    def card() -> str:
        """Carte / panneau arrondi. Style appliqué uniquement au frame direct."""
        c = theme_manager.colors()
        return f"""
            QFrame {{
                background-color: {c['bg_card']};
                border-radius: 15px;
                border: 1px solid {c['border_light']};
            }}
            QFrame > QFrame {{
                background-color: transparent;
                border: none;
                border-radius: 0px;
            }}
            QFrame > QWidget {{
                background-color: transparent;
                border: none;
            }}
            QLabel {{
                background-color: transparent;
                border: none;
            }}
        """

    @staticmethod
    def stat_card() -> str:
        """Carte statistique spécifique (StatCard)."""
        c = theme_manager.colors()
        return f"""
            QFrame#StatCard {{
                background-color: {c['bg_card']};
                border-radius: 20px;
                border: 1px solid {c['border_light']};
            }}
        """

    @staticmethod
    def container() -> str:
        """Conteneur générique (graph_container, form wrapper)."""
        c = theme_manager.colors()
        return f"""
            QFrame {{
                background-color: {c['bg_card']};
                border-radius: 15px;
                border: 1px solid {c['border']};
            }}
        """

    # ─────────────────────────────────────────────────────────────────────
    # SIDEBAR & NAVIGATION
    # ─────────────────────────────────────────────────────────────────────

    @staticmethod
    def sidebar() -> str:
        """Barre latérale de navigation."""
        c = theme_manager.colors()
        return f"""
            QFrame {{
                background-color: {c['bg_sidebar']};
                border-right: 1px solid {c['border_light']};
            }}
        """

    @staticmethod
    def nav_button() -> str:
        """Boutons de navigation dans la sidebar."""
        c = theme_manager.colors()
        return f"""
            QPushButton {{
                text-align: left;
                padding: 10px 20px;
                border: none;
                color: {c['text_primary']};
                border-radius: 8px;
                font-size: 14px;
            }}
            QPushButton:hover {{
                background-color: {c['primary_light']};
            }}
            QPushButton:checked {{
                background-color: {c['primary']};
                color: {c['text_inverse']};
                font-weight: bold;
            }}
        """

    @staticmethod
    def theme_button() -> str:
        """Bouton de bascule de thème."""
        c = theme_manager.colors()
        return f"""
            QPushButton {{
                border-radius: 20px;
                border: 1px solid {c['border']};
                background-color: {c['bg_card']};
                color: {c['text_primary']};
                padding: 8px 16px;
                font-size: 12px;
            }}
            QPushButton:hover {{
                background-color: {c['hover']};
                border-color: {c['primary']};
            }}
        """

    # ─────────────────────────────────────────────────────────────────────
    # ZONES DE CONTENU
    # ─────────────────────────────────────────────────────────────────────

    @staticmethod
    def content_area() -> str:
        """Zone de contenu principale."""
        c = theme_manager.colors()
        return f"background-color: {c['bg_main']}; color: {c['text_primary']};"

    @staticmethod
    def header() -> str:
        """Barre d'en-tête supérieure."""
        c = theme_manager.colors()
        return f"background-color: {c['bg_header']}; color: {c['text_primary']};"

    @staticmethod
    def footer() -> str:
        """Cadre de pied de sidebar."""
        c = theme_manager.colors()
        return f"""
            background-color: {c['primary']};
            border-radius: 12px;
            margin: 5px;
            color: {c['text_inverse']};
        """

    # ─────────────────────────────────────────────────────────────────────
    # LABELS & TEXTES
    # ─────────────────────────────────────────────────────────────────────

    @staticmethod
    def title() -> str:
        """Titre de page."""
        c = theme_manager.colors()
        return f"color: {c['text_primary']}; font-size: 20px; font-weight: bold;"

    @staticmethod
    def subtitle() -> str:
        """Sous-titre / description."""
        c = theme_manager.colors()
        return f"color: {c['text_secondary']}; font-size: 14px;"

    @staticmethod
    def label_value() -> str:
        """Valeur mise en avant (nombre dans une StatCard)."""
        c = theme_manager.colors()
        return f"color: {c['text_primary']}; font-size: 22px; font-weight: bold;"

    @staticmethod
    def label_caption() -> str:
        """Légende / caption."""
        c = theme_manager.colors()
        return f"color: {c['text_secondary']}; font-size: 12px;"

    # ─────────────────────────────────────────────────────────────────────
    # DIALOGUES & FORMULAIRES
    # ─────────────────────────────────────────────────────────────────────

    @staticmethod
    def dialog() -> str:
        """Fenêtre de dialogue (formulaire modal)."""
        c = theme_manager.colors()
        return f"background-color: {c['bg_card']}; color: {c['text_primary']};"

    @staticmethod
    def dialog_header() -> str:
        """En-tête d'un formulaire modal."""
        c = theme_manager.colors()
        return f"""
            background-color: {c['primary']};
            color: {c['text_inverse']};
            border-top-left-radius: 15px;
            border-top-right-radius: 15px;
            padding: 18px;
        """

    # ─────────────────────────────────────────────────────────────────────
    # BADGES & INDICATEURS
    # ─────────────────────────────────────────────────────────────────────

    @staticmethod
    def badge_success() -> str:
        """Badge de statut positif."""
        c = theme_manager.colors()
        return f"""
            background-color: {c['success']};
            color: {c['text_inverse']};
            border-radius: 10px;
            padding: 4px 12px;
            font-size: 11px;
            font-weight: bold;
        """

    @staticmethod
    def badge_warning() -> str:
        """Badge d'avertissement."""
        c = theme_manager.colors()
        return f"""
            background-color: {c['warning']};
            color: {c['text_inverse']};
            border-radius: 10px;
            padding: 4px 12px;
            font-size: 11px;
            font-weight: bold;
        """

    @staticmethod
    def badge_danger() -> str:
        """Badge d'erreur / critique."""
        c = theme_manager.colors()
        return f"""
            background-color: {c['danger']};
            color: {c['text_inverse']};
            border-radius: 10px;
            padding: 4px 12px;
            font-size: 11px;
            font-weight: bold;
        """

    @staticmethod
    def badge_info() -> str:
        """Badge informatif."""
        c = theme_manager.colors()
        return f"""
            background-color: {c['info']};
            color: {c['text_inverse']};
            border-radius: 10px;
            padding: 4px 12px;
            font-size: 11px;
            font-weight: bold;
        """

    # ─────────────────────────────────────────────────────────────────────
    # SCROLLBARS
    # ─────────────────────────────────────────────────────────────────────

    @staticmethod
    def scrollbar() -> str:
        """Barres de défilement personnalisées."""
        c = theme_manager.colors()
        return f"""
            QScrollBar:vertical {{
                background: {c['bg_card']};
                width: 8px;
                border-radius: 4px;
            }}
            QScrollBar::handle:vertical {{
                background: {c['border']};
                border-radius: 4px;
                min-height: 30px;
            }}
            QScrollBar::handle:vertical:hover {{
                background: {c['primary']};
            }}
            QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {{
                height: 0px;
            }}
        """

    # ─────────────────────────────────────────────────────────────────────
    # TOOLTIP
    # ─────────────────────────────────────────────────────────────────────

    @staticmethod
    def tooltip() -> str:
        """Style des infobulles."""
        c = theme_manager.colors()
        return f"""
            QToolTip {{
                background-color: {c['bg_card']};
                color: {c['text_primary']};
                border: 1px solid {c['border']};
                border-radius: 6px;
                padding: 6px 10px;
                font-size: 12px;
            }}
        """

    # ─────────────────────────────────────────────────────────────────────
    # QSS COMPLET (pour application globale via app.setStyleSheet)
    # ─────────────────────────────────────────────────────────────────────

    @staticmethod
    def global_qss() -> str:
        """
        Feuille de style complète à appliquer au QApplication.
        Remplace l'ancien style.qss avec support thématique.
        """
        c = theme_manager.colors()
        return f"""
            /* ── Base ── */
            QWidget {{
                background-color: {c['bg_main']};
                color: {c['text_primary']};
                font-family: "Segoe UI", sans-serif;
            }}

            /* ── Cartes ── */
            QFrame#StatCard, QFrame#cardFrame {{
                background-color: {c['bg_card']};
                border-radius: 15px;
                border: 1px solid {c['border_light']};
            }}

            /* ── Tableaux ── */
            QTableWidget {{
                background-color: {c['bg_table']};
                alternate-background-color: {c['bg_table_alt']};
                border: none;
                border-radius: 10px;
                gridline-color: {c['table_gridline']};
                selection-background-color: {c['table_selection']};
                color: {c['text_primary']};
            }}
            QHeaderView::section {{
                background-color: {c['table_header_bg']};
                color: {c['text_primary']};
                padding: 10px;
                border: none;
                border-bottom: 2px solid {c['table_header_border']};
                font-weight: bold;
            }}

            /* ── Bouton principal ── */
            QPushButton#BtnAdd {{
                background-color: {c['primary']};
                color: {c['text_inverse']};
                border-radius: 8px;
                padding: 8px 15px;
                font-weight: bold;
            }}
            QPushButton#BtnAdd:hover {{
                background-color: {c['primary_hover']};
            }}

            /* ── Scrollbars ── */
            QScrollBar:vertical {{
                background: {c['bg_card']};
                width: 8px;
                border-radius: 4px;
            }}
            QScrollBar::handle:vertical {{
                background: {c['border']};
                border-radius: 4px;
                min-height: 30px;
            }}
            QScrollBar::handle:vertical:hover {{
                background: {c['primary']};
            }}
            QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {{
                height: 0px;
            }}

            /* ── Tooltips ── */
            QToolTip {{
                background-color: {c['bg_card']};
                color: {c['text_primary']};
                border: 1px solid {c['border']};
                border-radius: 6px;
                padding: 6px 10px;
            }}
        """
