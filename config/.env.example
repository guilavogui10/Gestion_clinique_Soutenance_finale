# ============================================
# Configuration Vault
# ============================================

# URL du serveur Vault
VAULT_URL=http://127.0.0.1:8200

# Token d'authentification Vault
# ATTENTION: En production, utilisez un token sécurisé !
VAULT_TOKEN=mon_token_secret

# ============================================
# Configuration Email (pour l'envoi des codes OTP)
# ============================================

# Serveur SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Identifiants email
# ATTENTION: Utilisez un mot de passe d'application, pas votre mot de passe principal !
EMAIL_USER=votre_email@gmail.com
EMAIL_PASS=votre_mot_de_passe_application

# ============================================
# Configuration MinIO (stockage de fichiers)
# ============================================

# URL du serveur MinIO
MINIO_ENDPOINT=localhost:9000

# Identifiants MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Utiliser SSL/TLS
MINIO_SECURE=false

# ============================================
# Configuration Base de données
# ============================================

# Hôte de la base de données
DB_HOST=localhost

# Port de la base de données
DB_PORT=3306

# Nom de la base de données
DB_NAME=clinique_db

# Identifiants de connexion
DB_USER=root
DB_PASSWORD=votre_mot_de_passe

# ============================================
# INSTRUCTIONS
# ============================================
#
# 1. Copiez ce fichier à la racine du projet
# 2. Renommez-le en ".env" (sans .example)
# 3. Modifiez les valeurs selon votre configuration
# 4. NE PARTAGEZ JAMAIS ce fichier avec vos mots de passe !
#
# ============================================
