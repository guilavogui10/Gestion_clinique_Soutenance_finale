# --- CONFIGURATION MINIO ---
# URL de l'API MinIO (port 9000 = API, port 9001 = Console web)
MINIO_ENDPOINT=127.0.0.1:9000

# Identifiants MinIO (Access Key = username, Secret Key = password)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Nom du bucket créé dans la console MinIO
MINIO_BUCKET=clinique-data

# False = HTTP local, True = HTTPS avec certificat
MINIO_SECURE=False

# --- CONFIGURATION HASHICORP VAULT ---
# L'adresse locale où tourne ton serveur Vault
VAULT_URL=http://127.0.0.1:8200

# Le jeton que tu as défini dans ta commande 'vault server'
VAULT_TOKEN=mon_token_secret

# --- CONFIGURATION EMAIL (GMAIL) ---
# Le serveur de courrier sortant de Google
EMAIL_HOST=smtp.gmail.com

# Le port standard pour une connexion sécurisée TLS
EMAIL_PORT=587

# Ton adresse email d'expéditeur
EMAIL_USER=guilavoguimaurice20@gmail.com

# Ton mot de passe d'application Google (16 caractères)
# ⚠️ Ne mets pas d'espaces entre les lettres si possible
EMAIL_PASS=hvjmxzqeocgzmuuh